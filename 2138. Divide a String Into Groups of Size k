class Solution {
    public String[] divideString(String s, int k, char fill) {
        StringBuilder n=new StringBuilder(s);
        if(s.length()%k!=0)
        {
            for(int i=0;i<(k-s.length()%k);i++) n.append(fill);
        }
        String[] arr=new String[n.length()/k];
        int j=0;
        for(int i=0;i<n.length();i+=k){
            arr[j]=n.substring(i,k+i);
            j++;
        }
        return arr;
    }
} 
