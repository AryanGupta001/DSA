class Pair{
    int a;
    int b;
    Pair(int a,int b){
        this.a=a;
        this.b=b;
    }
}
class Solution {
    public void setMatrixZeroes(int[][] mat) {
        ArrayList<Pair> arr=new ArrayList<>();
        for(int i=0;i<mat.length;i++){
            for(int j=0;j<mat[i].length;j++){
                if(mat[i][j]==0) arr.add(new Pair(i,j));
            }
        }
        for(int i=0;i<arr.size();i++){
            int a=arr.get(i).a;
            int b=arr.get(i).b;
            zero(mat,a,b);
        }
    }
    public void zero(int[][] mat,int r,int c){
        for(int i=0;i<mat[r].length;i++){
            mat[r][i]=0;
        }
        for(int i=0;i<mat.length;i++){
            mat[i][c]=0;
        }
    }
}
