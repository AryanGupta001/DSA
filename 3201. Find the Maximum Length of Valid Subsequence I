class Solution {
    public int maximumLength(int[] nums) {
        int even=0,odd=0;
        int c=nums[0]%2,both=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]%2==0) {
                even++;
            }
            else if(nums[i]%2!=0) {
                odd++;
                
            }
            if(c==nums[i]%2){
                both++;
                c=1-c;
            }
        }
        int max=Math.max(even,both);
        return Math.max(max,odd);

    }
}
