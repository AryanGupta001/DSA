class Solution {
    public int matchPlayersAndTrainers(int[] players, int[] trainers) {
        Arrays.sort(players);
        Arrays.sort(trainers);
        int l=0;
        int r=0;
        int count=0;
        while(l<players.length && r<trainers.length){
            if(players[l]<=trainers[r]){
                count++;l++;r++;
            }
            else if(players[l]>trainers[r]) r++;
        }
        return count++;
    }
}
