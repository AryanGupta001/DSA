class Solution {
    public int findLucky(int[] arr) {
        int[] freq=new int[501];
        for(int i=0;i<arr.length;i++){
            freq[arr[i]]++;
        }
        int max=0;
        for(int i=1;i<freq.length;i++){
            if(freq[i]==i)
                max=Math.max(max,freq[i]);
        }
        return max>0 ? max:-1;
        
    }
}
