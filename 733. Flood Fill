class Solution { 
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        int ini=image[sr][sc];
        int[][] ans=image;
        int[] row={-1,0,+1,0};
        int[] col={0,+1,0,-1};
        dfs(ans,sr,sc,color,ini,image,row,col);
        return ans;
        
    }
    public void dfs(int[][] ans,int sr,int sc,int color,int ini,
    int[][] image,int[] row,int[] col){

        ans[sr][sc]=color;
        for(int i=0;i<4;i++){
            int nrow=sr+row[i];
            int ncol=sc+col[i];
            if ( nrow>=0 && nrow<image.length 
                && ncol>=0 && ncol<image[0].length
                && image[nrow][ncol]==ini && ans[nrow][ncol]!=color
            ){
                dfs(ans,nrow,ncol,color,ini,image,row,col);
            }
        }

    }
}
